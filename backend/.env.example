PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500
API_PUBLIC_URL=http://localhost:3000

# Firebase Admin service account values. Never use the web apiKey here.
FIREBASE_PROJECT_ID=redline-esports
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Start with sandbox credentials. Use production only after Cashfree approval and testing.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
